@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-panel login-panel-info">
            <div class="login-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3Z"></path>
                    <circle cx="12" cy="11" r="1.5" fill="currentColor" stroke="none"></circle>
                    <path d="M12 12.5v2"></path>
                </svg>
            </div>
            <h2>We've got you covered</h2>
            <p>Losing access happens. Enter your email and we'll send a secure link to reset your password.</p>
        </div>

        <div class="login-panel login-panel-form">
            <div class="login-header">
                <h2>Forgot password</h2>
                <p>We'll email you a reset link</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-group">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-primary-full">Send reset link</button>
            </form>

            <p class="login-footer">
                Remembered your password? <a asp-page="./Login">Log in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}