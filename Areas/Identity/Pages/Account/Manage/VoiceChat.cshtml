@page
@{
    ViewData["Title"] = "Voice chat";
    ViewData["ActivePage"] = ManageNavPages.VoiceChat;
}

<h3>@ViewData["Title"]</h3>
<p class="text-muted">Voice chat test</p>

<button id="voice-join" type="button" class="btn btn-primary">Join call</button>
<button id="voice-leave" type="button" class="btn btn-danger" disabled>Leave call</button>

<p id="voice-status" class="mt-3">Not in a call</p>
<ul id="voice-people"></ul>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/10.0.11/signalr.min.js"
            integrity="sha512-zV6tEyYm1c6KHVZUHmZUDIM/mWFZ5nHt08kt682k98cvUMAHTyJ0ZQkv2Q+KWIbbwN0wnboWYEvqbOztWwlMpg=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/voice-chat.js" asp-append-version="true"></script>
}
