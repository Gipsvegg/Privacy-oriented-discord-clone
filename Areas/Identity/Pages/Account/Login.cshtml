@page
@model LoginModel

@{
    ViewData["Title"] = "Welcome back";
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-panel login-panel-info">
            <div class="login-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3Z"></path>
                    <circle cx="12" cy="11" r="1.5" fill="currentColor" stroke="none"></circle>
                    <path d="M12 12.5v2"></path>
                </svg>
            </div>
            <h2>Your chats stay yours</h2>
            <p>End-to-end encrypted messaging with no server-side storage. Built for gamers who value their privacy.</p>
        </div>

        <div class="login-panel login-panel-form">
            <div class="login-header">
                <h2>Welcome back</h2>
                <p>Log in to your account</p>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-group">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-row-between">
                    <label class="remember-me">
                        <input asp-for="Input.RememberMe" />
                        <span>Remember me</span>
                    </label>
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
                </div>

                <button id="login-submit" type="submit" class="btn-primary-full">Log in</button>
            </form>

            <p class="login-footer">
                New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}