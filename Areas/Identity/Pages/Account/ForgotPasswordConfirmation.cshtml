@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Check your email";
}

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-panel login-panel-info">
            <div class="login-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3Z"></path>
                    <circle cx="12" cy="11" r="1.5" fill="currentColor" stroke="none"></circle>
                    <path d="M12 12.5v2"></path>
                </svg>
            </div>
            <h2>We've got you covered</h2>
            <p>Losing access happens. Enter your email and we'll send a secure link to reset your password.</p>
        </div>

        <div class="login-panel login-panel-form confirmation-panel">
            <div class="confirmation-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16v16H4z"></path>
                    <path d="m4 6 8 7 8-7"></path>
                </svg>
            </div>
            <h2>Check your email</h2>
            <p class="confirmation-text">
                If an account exists for that address, we've sent a link to reset your password.
                It should arrive within a few minutes — check your spam folder if you don't see it.
            </p>

            <a asp-page="./Login" class="btn-primary-full confirmation-btn">Back to log in</a>
        </div>
    </div>
</div>