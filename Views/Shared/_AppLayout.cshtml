<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ikt201_project</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    @*<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>*@
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/voice-chat.css"/>
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/friends.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/group-creator-dialog.css"/>
    @* <link rel="stylesheet" href="~/ikt201_project.styles.css" asp-append-version="true"/> *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
    
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
<div class="app-shell">
    <main class="app-main">
        @RenderBody()
    </main>


    <div class="info-bar">
        <div>
            <a asp-area="Identity" asp-page="/Account/Manage/Index">
                <i class="bi bi-gear-fill"></i>
            </a>
        </div>
        <div class="settings">
            &copy; 2026 - ikt201_project - <a asp-area="" asp-controller="Home" asp-action="Privacy"> Privacy</a>
        </div>
    </div>
    @Html.AntiForgeryToken()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8/dist/browser/signalr.min.js"></script>
    <script src="~/js/messageGetter.js" asp-append-version="true"></script>
    <script type="module" src="~/js/crypto.bundle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</div>
</body>
</html>