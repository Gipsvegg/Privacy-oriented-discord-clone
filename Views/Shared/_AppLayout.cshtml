@{
    Context.Request.Cookies.TryGetValue("theme", out var theme);
    if (theme == null || !Themes.ValidThemes.ContainsKey(theme))
    {
        theme = "default";
    }
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme" data-bs-theme="@Themes.ValidThemes[theme]">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ikt201_project</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    @*<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>*@
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/voice-chat.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/friends.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/group-creator-dialog.css"/>
    @* <link rel="stylesheet" href="~/ikt201_project.styles.css" asp-append-version="true"/> *@
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
<div class="app-shell">
    <main class="app-main">
        @RenderBody()
    </main>
    @Html.AntiForgeryToken()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/conversations.js" asp-append-version="true"></script>
    <script src="~/js/server-ui.js" asp-append-version="true"></script>
    <script type="module" src="~/js/crypto.bundle.js" asp-append-version="true"></script>
    <script type="module" src="~/js/markdown-render.bundle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</div>
</body>
</html>