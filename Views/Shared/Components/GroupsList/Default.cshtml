@model List<Group>

@foreach (var group in Model)
{
    <a class="friend" data-conversation-id="@group.ConversationId" asp-controller="Dashboard" asp-action="Conversation" asp-route-id="@group.ConversationId">
        <span class="friend-text">@group.ConversationName</span><b class="unread" data-conversation-id="@group.ConversationId" hidden></b><partial name="_CallCount" model="(group.ConversationId, false)"/>
    </a>
}