@model List<ikt201_project.ViewComponents.FriendLink>

@if (!Model.Any())
{
    <p class="text-muted ps-3 mb-0">No friends yet</p>
}
else
{
    @foreach (var friend in Model)
    {
        if (friend.ConversationId != null)
        {
            <a class="friend" data-friend-id="@friend.Id" data-conversation-id="@friend.ConversationId" asp-controller="Dashboard" asp-action="Conversation" asp-route-id="@friend.ConversationId">
                @friend.Name<b class="unread" data-conversation-id="@friend.ConversationId" hidden></b><partial name="_CallCount" model="(friend.ConversationId, true)"/>
            </a>
        }
        else
        {
            <button type="button" class="start-dm" data-friend-id="@friend.Id">@friend.Name</button>
        }
        
    }
}