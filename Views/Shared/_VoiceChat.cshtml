@* voice chat seksjonen nederst i sidebaren, voice-chat.js bruker iden til elementene *@
<div class="sidebar-section voice-section">
    <h6 class="text-center">Voice chat</h6>
    <input id="voice-room" type="text" class="form-control form-control-sm mb-2" placeholder="Room name" value="General" />
    <p id="voice-status">Not in a call</p>
    @* viser bare antall, trykk for å se hvem som er der *@
    <details id="voice-details" hidden>
        <summary id="voice-count">1 connected</summary>
        <ul id="voice-people">
            <li>@User.Identity?.Name (you)</li>
        </ul>
    </details>
    <div class="voice-buttons">
        <button id="voice-join" type="button" class="btn btn-outline-success btn-sm"><i class="bi bi-telephone-fill"></i> Join</button>
        <button id="voice-leave" type="button" class="btn btn-outline-danger btn-sm" disabled><i class="bi bi-telephone-x-fill"></i> Leave</button>
    </div>
</div>
