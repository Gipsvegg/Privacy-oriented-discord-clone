@* voice chat seksjonen nederst i sidebaren, voice-chat.js bruker iden til elementene *@
<div class="sidebar-section voice-section">
    <h6 class="text-center">Voice chat</h6>
    <p id="voice-status">Not in a call</p>
    <ul id="voice-people" hidden>
        <li><i class="bi bi-person-fill"></i> @User.Identity?.Name (you)</li>
    </ul>
    <div class="voice-buttons">
        <button id="voice-mute" type="button" class="btn btn-outline-warning btn-sm" disabled><i class="bi bi-mic-fill"></i> Mute</button>
        <button id="voice-leave" type="button" class="btn btn-outline-danger btn-sm" disabled><i class="bi bi-telephone-x-fill"></i> Leave</button>
    </div>
</div>
