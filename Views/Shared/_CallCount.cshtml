@* hvor mange som er i samtalen, voice-chat.js oppdaterer tallet *@
@model string
@{
    var names = ikt201_project.Hubs.VoiceHub.NamesInCall(Model);
}
<span class="call-count bi bi-telephone-fill" data-conversation-id="@Model" title="@string.Join(", ", names)" hidden="@(names.Count == 0)">@names.Count</span>
