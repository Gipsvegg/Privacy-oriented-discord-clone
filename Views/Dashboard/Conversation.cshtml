@model List<Message>


<div class="messages">
    @{ string prevSenderId = ""; }
    @foreach (var msg in Model)
    {
        bool showSender = !string.Equals(msg.SenderId, prevSenderId);
        prevSenderId = msg.SenderId;

        if (showSender)
        {
            <p>@msg.SenderId:</p>
        }
        <p data-sender-id="@msg.SenderId">@msg.Text</p>
    }
</div>

<form id="send-form" class="input-field" data-friend-id="@ViewBag.FriendId">
        <textarea id="message-input" name="text" rows="1" autocomplete="off"></textarea>
</form>



