@model Group

<div class="conversation-message-window">
    <h2 class="conversation-name" class="text-center">@Model.ConversationName</h2>
    <div class="messages"></div>

    <form id="send-form" class="input-field" data-conversation-id="@ViewBag.conversationId">
        <button id="create-group-btn" type="button" class="icon-btn">
            <i class="bi bi-plus"></i>
        </button>
        <textarea id="message-input" name="text" rows="1" autocomplete="off"></textarea>
    </form>
</div>

<div class="conversation-information-window">
    <h6>Members</h6>
    @foreach (var member in Model.Members)
    {
        <p class="members">@member.MemberName : @member.Role</p>
    }
    <div class="group-button">
        <button id="open-group-invitor" type="button">add</button>
        <button id="open-group-leaver" type="button">leave</button>
    </div>
</div>




