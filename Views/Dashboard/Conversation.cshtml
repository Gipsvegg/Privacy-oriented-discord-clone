@using System.Security.Claims
@model Group

@{
    var me = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var dmName = Model.Members.FirstOrDefault(m => m.MemberId != me)?.MemberName;
}

<div class="conversation-message-window">
    <div class="conversation-header">
        <h2 class="conversation-name" class="text-center">
            @{
                if (Model.IsDirect)
                {
                    @dmName
                }
                else
                {
                    @Model.ConversationName
                }
            }
        </h2>
        <span class="call-info">
            <partial name="_CallCount" model="(Model.ConversationId, Model.IsDirect)"/>
            <button id="call-button" type="button" class="btn btn-sm btn-outline-success" data-conversation-id="@Model.ConversationId"><i class="bi bi-telephone-fill"></i> Call</button>
        </span>
    </div>
    <div class="messages"></div>

    <form id="send-form" class="input-field" data-conversation-id="@Model.ConversationId">
        <button id="create-group-btn" type="button" class="icon-btn">
            <i class="bi bi-plus"></i>
        </button>
        @if (Model.IsDirect)
        {
            <textarea id="message-input" name="text" rows="1" autocomplete="off" placeholder="Message @dmName"></textarea>
        }
        else
        {
            <textarea id="message-input" name="text" rows="1" autocomplete="off" placeholder="Message @Model.ConversationName"></textarea>
        }
        
    </form>
</div>
<div id="member-panel">
    <partial name="ConversationMemberList"/>
</div>



