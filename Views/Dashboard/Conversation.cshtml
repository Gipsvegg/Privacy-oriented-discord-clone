@model List<Message>

<div class="messages">
    <div>
        @{ int? prevSenderId = 0; }
        @foreach (var msg in Model)
        {
            bool showSender = msg.SenderId != prevSenderId;
            prevSenderId = msg.SenderId;

            if (showSender)
            {
                <p>@msg.SenderId:</p>
            }
            <p>@msg.Text</p>
            
        }
    </div>

<form id="send-form" class="input-field">
    <textarea id="message-input" name="text" rows="1" autocomplete="off"></textarea>
    <button type="submit">Send</button>
</form>
</div>


