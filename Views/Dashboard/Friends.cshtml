@model ikt201_project.Models.ViewModels.FriendsViewModel




<div class="main-content">
    <h2 class="text-center">Friends</h2>
    <div class="friends-page">
        @if (TempData["Message"] is string message)
           {
               <div class="alert alert-info">@message</div>
           }
        <form asp-controller="Dashboard" asp-action="SendFriendRequest" method="post" id="friend-form" class="mb-4">
            <div class="input-group">
                <input type="text" name="username"  placeholder="Add friend by username" required />
                <button id="add-friend-button" type="submit" >Send request</button>
            </div>
        </form>
        <div id="friend-manager">
            @await Component.InvokeAsync("FriendsList", new { invoker = "ManageFriends" })
        </div>
    </div>
</div>
