@using System.Security.Claims
@model Group

<div class="conversation-information-window">
    @if (!Model.IsDirect)
    {
        var me = User.FindFirstValue(ClaimTypes.NameIdentifier);
        var isAdmin = Model.Members.Any(m => m.MemberId == me && m.Role == "admin"); 
        var currentRole = Model.Members.OrderBy(m => m.Role).FirstOrDefault()?.Role ?? "unknown";
        var changed = true;
        <h6 class="member-list">
            Members
            <div class="group-control">
                <button id="open-group-invitor" type="button"><i class="bi bi-person-add"></i></button>
                <button type="button"><i class="bi bi-three-dots"></i></button>
            </div>
        </h6>
        foreach (var member in Model.Members.OrderBy(m => m.Role))
        {
            if (member.Role != currentRole)
            {
                changed = true;
                currentRole = member.Role;
            }
            if (changed)
            {
                <p class="roles">@currentRole - @Model.Members.Count(m => m.Role == currentRole)</p>
                changed = false;
            }
            
            <div class="dropdown">
                <button class="member-control" data-member-id="@member.MemberId">@member.MemberName</button>
                <ul class="dropdown-menu">
                    @if (!ViewBag.FriendIds.Contains(member.MemberId) && me != member.MemberId)
                    {
                        <li><button class="dropdown-item add-friend">Add friend</button></li>
                    }
                    else
                    {
                        <li class="dropdown-item send-dm">Message</li>
                    }
                    @if (isAdmin && member.Role != "admin") 
                    {
                        <li><button class="dropdown-item promote">Make admin</button></li>
                        <li><hr class="dropdown-divider"/></li>
                        <li><button class="dropdown-item text-danger kill-button">Dissipate</button></li>
                    }
                </ul>
            </div>
        }
        <div class="group-button">
            <button id="rename-group" type="button"><i class="bi bi-pencil-square"></i> Rename group</button>
            <button id="open-group-leaver" data-conversation-id="@Model.ConversationId" type="button" class="btn btn-outline-danger"><i class="bi bi-box-arrow-right"></i> Leave group</button>
        </div>
    }
    else
    {
        var friend =  Model.Members.FirstOrDefault(m => m.MemberId != User.FindFirstValue(ClaimTypes.NameIdentifier));
        <h6>YOUR FRIEND</h6>
        if (friend != null)
        {
            <p data-member-id="@friend.MemberId">@friend.MemberName</p>
        }
        else
        {
            <p>DELETED USER</p>
        }
    }
</div>
@await Component.InvokeAsync("FriendsList", new {invoker = "addToGroup", conversationId = Model.ConversationId})