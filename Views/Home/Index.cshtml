@{
    ViewData["Title"] = "Haven — Private chat and voice for real communities";
    ViewData["FullWidth"] = true;
}

@* Add haven--bleed to this div only if you are NOT using the FullWidth flag in _Layout. *@
<div class="haven">

    <section class="haven-hero">
        <div class="haven-hero__text">
            <h1>Your community's conversations, with no onlookers.</h1>
            <p class="haven-hero__sub">
                Haven is made for people to connect, without having to worry about being used as a data source.
                End-to-end encryption by default, locally stored messages and locally hosted servers, all in one easy to use <b>FREE</b> website.
            </p>
            <div class="haven-hero__actions">
                <a class="haven-btn haven-btn--primary haven-btn--lg"
                   href="@Url.Page("/Account/Register", new { area = "Identity" })">Register here</a>
                <a class="haven-hero__secondary" href="#security">See the security model</a>
            </div>
            <p class="haven-hero__trust">No unnecessary info collected&nbsp;&middot; Nothing sold&nbsp;&middot; Completely free</p>
        </div>

        <div class="haven-hero__art" aria-hidden="true">
            <div class="haven-art__bubble">
                <span class="haven-art__dot"></span>
                <span class="haven-art__dot"></span>
                <span class="haven-art__dot"></span>
            </div>
            <div class="haven-art__seal">
                <svg viewBox="0 0 24 24" class="haven-art__lock">
                    <path d="M7 10V7a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="4.5" y="10" width="15" height="10" rx="2.5" fill="currentColor" />
                    <circle cx="12" cy="14.6" r="1.3" fill="#12161A" />
                    <rect x="11.35" y="15.3" width="1.3" height="2.4" rx="0.5" fill="#12161A" />
                </svg>
            </div>
            <span class="haven-art__particle haven-art__particle--1"></span>
            <span class="haven-art__particle haven-art__particle--2"></span>
            <span class="haven-art__particle haven-art__particle--3"></span>
        </div>
    </section>

    <section class="haven-nots" aria-labelledby="nots-heading">
        <h2 id="nots-heading">What Haven doesn't do</h2>

        <ul class="haven-nots__list">
            <li>
                <p class="haven-nots__claim">We don't scan messages for ad targeting.</p>
                <p class="haven-nots__detail">Not the message body, not "just metadata." There's no process reading your conversations in the background.</p>
            </li>
            <li>
                <p class="haven-nots__claim">We don't keep a permanent log.</p>
                <p class="haven-nots__detail">Delete a message and it's removed from our servers within seconds — not just hidden from your view.</p>
            </li>
            <li>
                <p class="haven-nots__claim">We don't ask for a phone number.</p>
                <p class="haven-nots__detail">A username and a password are enough to stand up a server and start inviting people.</p>
            </li>
            <li>
                <p class="haven-nots__claim">We don't sell data to anyone.</p>
                <p class="haven-nots__detail">There's nothing to sell — voice and text are end-to-end encrypted by default, so we can't read them either.</p>
            </li>
        </ul>
    </section>

    <section class="haven-features" aria-labelledby="features-heading">
        <h2 id="features-heading">Built for servers, not for engagement metrics</h2>

        <div class="haven-features__list">
            <article class="haven-feature haven-feature--lead">
                <h3>Voice that stays private</h3>
                <p>Calls are end-to-end encrypted, with a key exchange your admins can see and verify. No one listening in — including us.</p>
            </article>
            <article class="haven-feature">
                <h3>Screen share without exposure</h3>
                <p>Participant-only broadcast by default. Recording is opt-in and encrypted the same way as voice.</p>
            </article>
            <article class="haven-feature">
                <h3>Moderation without surveillance</h3>
                <p>Mods can remove people and content without Haven needing to read every message to make that possible.</p>
            </article>
            <article class="haven-feature">
                <h3>Bring your community with you</h3>
                <p>Import roles, channels, and emoji from your existing server in one pass. Nobody has to start over.</p>
            </article>
        </div>
    </section>

    <section class="haven-security" id="security" aria-labelledby="security-heading">
        <div class="haven-security__text">
            <h2 id="security-heading">Every conversation has a fingerprint</h2>
            <p>
                Compare it with the person you're talking to — in person, or over a second channel —
                and you'll know no one is sitting in the middle. It's the same idea behind a safety
                number, applied to every direct message and call.
            </p>
        </div>
        <div class="haven-security__code">
            <p class="haven-security__label">Safety number for this conversation</p>
            <p class="haven-security__hash">4F2A&nbsp;9C11&nbsp;88DE&nbsp;5B07<br />3341&nbsp;AA9F&nbsp;0021&nbsp;7E6C</p>
            <span class="haven-security__verified">Verified match</span>
        </div>
    </section>

    <section class="haven-cta" aria-labelledby="cta-heading">
        <h2 id="cta-heading">Start a server in about a minute</h2>
        <p>
            Pick a name, invite your people, and you're talking. No phone number, no credit card,
            nothing to configure before the first message goes out.
        </p>
        <div class="haven-cta__actions">
            <a class="haven-btn haven-btn--primary haven-btn--lg"
               href="@Url.Page("/Account/Register", new { area = "Identity" })">Register here</a>
            <a class="haven-btn haven-btn--ghost haven-btn--lg"
               href="@Url.Page("/Account/Login", new { area = "Identity" })">Sign in</a>
        </div>
    </section>

</div>
